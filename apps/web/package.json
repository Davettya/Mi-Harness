{
  "name": "mi-harness-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run --pool=threads --maxWorkers=1 --minWorkers=1",
    "generate:api": "openapi-typescript ../../docs/generated/openapi.json -o src/api/generated/schema.ts && prettier --write src/api/generated/schema.ts",
    "format": "prettier --write src vite.config.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "openapi-typescript": "7.6.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
